[TEMPLATE]
# ---- Server ----
PORT=5000
FRONTEND_URL=http://localhost:5173
# Production: your Vercel frontend origin, e.g. https://voiceguard-ai.vercel.app
# (no trailing slash). Used for CORS on the deployed backend.

# ---- Supabase (logs + reports; memory fallback when empty) ----
# Project Settings → API → Project URL + service_role key.
# Deploy: set these as env vars on your backend host (Render/Railway/Fly).
# Never ship the service_role key to the frontend or Vercel.
SUPABASE_URL=
SUPABASE_KEY=

# ---- Groq cloud LLM (generated risk reports; empty = templates only) ----
# console.groq.com → API Keys → paste here.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Score cutoffs (tune without touching code) ----
HIGH_RISK_AT=70
MEDIUM_RISK_AT=45
SIMILARITY_THRESHOLD=75
