# ---- Server ----
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---- MongoDB ----
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/sentinel
# Empty = run with in-memory store (demo still works, data resets on restart).
MONGO_URI=
MONGO_DB=sentinel

# ---- Optional Python ML microservice (../backend/ml-service/app.py) ----
# Scores come from there when reachable, else built-in heuristic is used.
ML_SERVICE_URL=http://localhost:8001

# ---- Detection thresholds (mirror frontend Settings) ----
SECURITY_THRESHOLD=70
SIMILARITY_THRESHOLD=75
CHALLENGE_THRESHOLD=55
AUTO_BLOCK=true

# ---- Twilio (all optional — mock mode without these) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
PUBLIC_BACKEND_URL=http://localhost:5000
