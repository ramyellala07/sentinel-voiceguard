# Copy to .env and fill in when a real backend exists.
# The app works without this file (mock/demo mode).

# Socket.IO backend, e.g. http://localhost:5000
VITE_SOCKET_URL=

# REST backend for Twilio token + ML APIs, e.g. http://localhost:5000
VITE_BACKEND_URL=

# Your Twilio number (display only), e.g. +15551234567
VITE_TWILIO_NUMBER=
