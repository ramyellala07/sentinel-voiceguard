[TEMPLATE]
# Copy to .env and fill in when a real backend exists.
# The app works without this file (mock/demo mode).
#
# These are PUBLIC frontend vars — Vite inlines them into the JS bundle at
# build time. On Vercel, set them under Project → Settings → Environment
# Variables, then REDEPLOY (changes only take effect on a new build).

# REST backend for Twilio token + ML APIs.
# Local: http://localhost:5000
# Production: your deployed FastAPI origin, e.g. https://sentinel-api.onrender.com
VITE_BACKEND_URL=

# Socket.IO backend. The current backend build has no sockets — leave empty
# unless you re-enable them. Local: http://localhost:5000
VITE_SOCKET_URL=

# Your Twilio number (display only), e.g. +15551234567
VITE_TWILIO_NUMBER=
